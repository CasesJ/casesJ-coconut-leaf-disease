# Deployment only: set this in your hosting platform's encrypted secret store.
# Paste the complete, single-line JSON of the newly rotated Firebase service account.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Must remain false for hosted environments. Private API routes require verified tokens.
ALLOW_UNVERIFIED_FIREBASE_TOKENS=false

# Optional local-development alternative. This file must be outside the repository
# or ignored; do not set it in hosted deployments.
GOOGLE_APPLICATION_CREDENTIALS=

# Required only when using a non-default Firebase Storage bucket.
FIREBASE_STORAGE_BUCKET=

# Required in the hosted backend only. Keep all values in the hosting platform's
# encrypted secret manager; never expose API_SECRET or add these to frontend code.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_READ_TIMEOUT_SECONDS=20

# Abuse controls. Each image quota lasts 24 hours from that user's first
# counted upload, in Philippine time (Asia/Manila).
IMAGE_INFERENCE_DAILY_LIMIT=100
IMAGE_INFERENCE_PER_MINUTE=10
EXPORTS_PER_MINUTE=5
AUTH_TOKEN_CHECKS_PER_MINUTE=10
WS_CONNECTIONS_PER_USER=2
WS_FRAMES_PER_SECOND=10
WS_MAX_FRAME_BYTES=3000000
MAX_IMAGE_UPLOAD_BYTES=10000000

# Set true only behind a reverse proxy that removes client-supplied
# X-Forwarded-For headers and injects its own trusted value.
TRUST_PROXY_HEADERS=false
